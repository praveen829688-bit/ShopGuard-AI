        text
    )

    if budget_match:
        intent["budget"] = float(
            budget_match.group(1).replace(",", "")
        )

    # RAM
    ram_match = re.search(
        r"(\d+)\s*gb\s*(?:ram|memory)",
        text
    )

    if ram_match:
        intent["ram"] = int(ram_match.group(1))

    # Storage
    storage_match = re.search(
        r"(\d+)\s*(?:gb|tb)\s*(?:ssd|storage)",
        text
    )

    if storage_match:
        intent["storage"] = storage_match.group(0)

    # Purpose
    if any(word in text for word in ["coding", "programming", "developer", "development"]):
        intent["purpose"] = "Coding"

    elif any(word in text for word in ["gaming", "game", "gaming laptop"]):
        intent["purpose"] = "Gaming"

    elif any(word in text for word in ["study", "student", "college"]):
        intent["purpose"] = "Study"

    elif any(word in text for word in ["office", "work", "business"]):
        intent["purpose"] = "Work"

    # Preferences
    intent["ecoPreferred"] = any(
        word in text
        for word in [
            "eco",
            "eco-friendly",
            "sustainable",
            "green"
        ]
    )

    intent["lowReturnRisk"] = any(
        word in text
        for word in [
            "low return",
            "safe return",
            "easy return",
            "low return risk"
        ]
    )

    intent["highTrust"] = any(
        word in text
        for word in [
            "trusted seller",
            "high trust",
            "reliable seller",
            "safe seller"
        ]
    )

    return intent


def calculate_intent_match(product, intent):

    score = 0
    reasons = []
    penalties = []

    # Category
    if intent["category"]:

        if product["category"] == intent["category"]:
            score += 30

            reasons.append(
                "Matches your requested product category."
            )

        else:
            penalties.append(
                "Different product category."
            )

    else:
        score += 20

    # Budget
    if intent["budget"]:

        if product["price"] <= intent["budget"]:
            score += 20

            reasons.append(
                "Fits within your budget."
            )

        else:
            difference = (
                product["price"] -
                intent["budget"]
            )

            if difference <= intent["budget"] * 0.10:
                score += 8

                reasons.append(
                    "Slightly above budget but close."
                )

            else:
                penalties.append(
                    "Exceeds your stated budget."
                )

    else:
        score += 15

    # RAM
    if intent["ram"]:

        product_ram = 0

        for feature in product["features"]:

            match = re.search(
                r"(\d+)\s*GB\s*RAM",
                feature,
                re.I
            )

            if match:
                product_ram = int(
                    match.group(1)
                )

        if product_ram >= intent["ram"]:

            score += 10

            reasons.append(
                f"Meets your {intent['ram']}GB RAM requirement."
            )

        else:

            penalties.append(
                "Does not fully meet your RAM requirement."
            )

    # Purpose
    if intent["purpose"] == "Coding":

        if product["category"] == "Laptops":

            score += 10

            if product["qualityScore"] >= 85:
                reasons.append(
                    "Strong suitability for coding and development."
                )

    elif intent["purpose"] == "Gaming":

        if product["qualityScore"] >= 90:
            score += 10

    elif intent["purpose"] == "Study":

        if product["price"] <= 60000:
            score += 10

    elif intent["purpose"] == "Work":

        if product["compatibilityScore"] >= 90:
            score += 10

    # Eco preference
    if intent["ecoPreferred"]:

        if product["ecoScore"] >= 80:
            score += 8

            reasons.append(
                "Strong sustainability score."
            )

        else:
            penalties.append(
                "Eco score is below your preference."
            )

    # Return preference
    if intent["lowReturnRisk"]:

        if product["returnRisk"] <= 15:
            score += 8

            reasons.append(
                "Predicted return risk is low."
            )

        else:
            penalties.append(
                "Return risk is higher than preferred."
            )

    # Seller preference
    if intent["highTrust"]:

        if product["sellerTrust"] >= 90:
            score += 8

            reasons.append(
                "Seller has a strong trust score."
            )

        else:
            penalties.append(
                "Seller trust is below your preference."
            )

    # General intelligence
    score += round(
        product["qualityScore"] * 0.05
    )

    score += round(
        product["reviewTrust"] * 0.05
    )

    score = min(
        100,
        max(0, score)
    )

    return score, reasons, penalties


