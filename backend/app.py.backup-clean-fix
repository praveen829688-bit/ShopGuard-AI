def find_product(product_id):
    return next(
        (p for p in PRODUCTS if p["id"] == product_id),
        None
    )


def price_intelligence(product):
    price = product.get("price", 0)
    original_price = product.get("originalPrice", price)

    try:
        price = float(price)
    except (TypeError, ValueError):
        price = 0

    try:
        original_price = float(original_price)
    except (TypeError, ValueError):
        original_price = price

    if original_price > 0:
        discount = round(
            ((original_price - price) / original_price) * 100,
            2
        )
    else:
        discount = 0

    if discount >= 40:
        score = 90
    elif discount >= 25:
        score = 80
    elif discount >= 15:
        score = 70
    elif discount >= 5:
        score = 60
    else:
        score = 50

    return {
        "score": score,
        "price": price,
        "originalPrice": original_price,
        "discount": discount
    }


def review_intelligence(product):

    rating = product["rating"]
    reviews = product["reviews"]

    base = min(100, reviews / 20)

    rating_score = rating / 5 * 100

    trust = round(
        rating_score * 0.55 +
        base * 0.45
    )

    suspicious = max(
        2,
        round((100 - product["reviewTrust"]) / 3)
    )

    return {
        "score": product["reviewTrust"],
        "rating": rating,
        "reviewCount": reviews,
        "estimatedSuspicious": suspicious,
        "status": (
            "HIGH TRUST"
            if product["reviewTrust"] >= 90
            else "MODERATE TRUST"
        )
    }


def seller_intelligence(product):

    trust = product["sellerTrust"]

    if trust >= 95:
        level = "VERY HIGH"
    elif trust >= 90:
        level = "HIGH"
    elif trust >= 75:
        level = "MODERATE"
    else:
        level = "LOW"

    return {
        "score": trust,
        "level": level,
        "verified": trust >= 90
    }


def scam_intelligence(product):
    price_data = price_intelligence(product)

    price_score = price_data.get("score", 50)

    seller_risk = 100 - product.get("sellerTrust", 50)
    review_risk = 100 - product.get("reviewTrust", 50)
    price_risk = max(0, 100 - price_score)

    scam_risk = round(
        (price_risk * 0.4) +
        (seller_risk * 0.3) +
        (review_risk * 0.3),
        2
    )

    if scam_risk >= 70:
        level = "HIGH"
    elif scam_risk >= 40:
        level = "MEDIUM"
    else:
        level = "LOW"

    return {
        "score": round(100 - scam_risk, 2),
        "risk": scam_risk,
        "level": level,
        "priceRisk": price_risk,
        "sellerRisk": seller_risk,
        "reviewRisk": review_risk
    }


def return_intelligence(product):

    risk = product["returnRisk"]

    if risk <= 10:
        prediction = "VERY LOW"
    elif risk <= 18:
        prediction = "LOW"
    elif risk <= 30:
        prediction = "MEDIUM"
    else:
        prediction = "HIGH"

    return {
        "risk": risk,
        "prediction": prediction
    }


def regret_intelligence(product, budget):

    budget_fit = 100

    if budget:

        if product["price"] <= budget:
            budget_fit = 100
        else:
            budget_fit = max(
                0,
                round(
                    100 -
                    (
                        (product["price"] - budget)
                        / budget
                    ) * 100
                )
            )

    need_match = product["compatibilityScore"]

    return_risk = product["returnRisk"]

    satisfaction = (
        budget_fit * 0.35 +
        need_match * 0.40 +
        (100 - return_risk) * 0.25
    )

    regret = round(100 - satisfaction)

    if regret <= 15:
        level = "LOW"
    elif regret <= 30:
        level = "MEDIUM"
    else:
        level = "HIGH"

    return {
        "score": regret,
        "level": level
    }


def final_decision(product, budget=None):

    price = price_intelligence(product)
    reviews = review_intelligence(product)
    seller = seller_intelligence(product)
    scam = scam_intelligence(product)
    returns = return_intelligence(product)
    regret = regret_intelligence(product, budget)

    compatibility = product["compatibilityScore"]
    quality = product["qualityScore"]
    eco = product["ecoScore"]

    budget_score = 100

    if budget:

        if product["price"] <= budget:
            budget_score = 100
        else:
            budget_score = max(
                0,
                round(
                    100 -
                    (
                        (product["price"] - budget)
                        / budget
                    ) * 100
                )
            )

    security_score = 100 - scam["score"]

    return_safety = 100 - product["returnRisk"]

    score = round(
        price["score"] * 0.14 +
        quality * 0.13 +
        seller["score"] * 0.14 +
        reviews["score"] * 0.11 +
        compatibility * 0.11 +
        return_safety * 0.08 +
        eco * 0.06 +
        budget_score * 0.10 +
        security_score * 0.07 +
        (100 - regret["score"]) * 0.06
    )

    if scam["score"] >= 50:
        action = "AVOID"
    elif score >= 80:
        action = "BUY"
    elif score >= 65:
        action = "WAIT"
    else:
        action = "AVOID"

    reasons = []

    if price["score"] >= 85:
        reasons.append(
            "Current price provides strong value."
        )

    if seller["score"] >= 90:
        reasons.append(
            "Seller has a strong trust profile."
        )

    if reviews["score"] >= 85:
        reasons.append(
            "Review authenticity indicators are strong."
        )

    if scam["score"] <= 20:
        reasons.append(
            "No major scam indicators detected."
        )

    if returns["risk"] <= 15:
        reasons.append(
            "Predicted return risk is low."
        )

    if compatibility >= 90:
        reasons.append(
            "Product compatibility is excellent."
        )

    if eco >= 80:
        reasons.append(
            "Product has a strong sustainability score."
        )

    if budget:
        if product["price"] <= budget:
            reasons.append(
                "Product fits within your stated budget."
            )
        else:
            reasons.append(
                "Product is above your stated budget."
            )

    warnings = []

    if scam["score"] > 25:
        warnings.append(
            "Some purchase-risk signals require attention."
        )

    if returns["risk"] > 20:
        warnings.append(
            "Return probability is higher than average."
        )

    if regret["score"] > 30:
        warnings.append(
            "Potential buyer regret is elevated."
        )

    return {
        "score": score,
        "action": action,
        "riskLevel": (
            "LOW"
            if score >= 80
            else "MEDIUM"
            if score >= 65
            else "HIGH"
        ),
        "factors": {
            "price": price,
            "quality": quality,
            "seller": seller,
            "reviews": reviews,
            "scam": scam,
            "returns": returns,
            "compatibility": compatibility,
            "eco": eco,
            "budget": budget_score,
            "security": security_score,
            "regret": regret
        },
        "reasons": reasons,
        "warnings": warnings
    }


@app.get("/api/products")
def products():

    search = request.args.get(
        "search",
        ""
    ).lower()

    results = PRODUCTS

    if search:

        results = [
            p for p in PRODUCTS
            if search in p["name"].lower()
            or search in p["category"].lower()
            or search in p["brand"].lower()
        ]

    return jsonify(results)


@app.get("/api/products/<int:product_id>")
def product(product_id):

    item = find_product(product_id)

    if not item:

        return jsonify({
            "error": "Product not found"
        }), 404

    return jsonify(item)


@app.get("/api/decision/<int:product_id>")
def decision(product_id):

    item = find_product(product_id)

    if not item:

        return jsonify({
            "error": "Product not found"
        }), 404

    budget = request.args.get(
        "budget",
        type=float
    )

    result = final_decision(
        item,
        budget
    )

    return jsonify({
        "product": item,
        "decision": result
    })


@app.get("/api/analyze/<int:product_id>")
def analyze(product_id):

    item = find_product(product_id)

    if not item:

        return jsonify({
            "error": "Product not found"
        }), 404

    budget = request.args.get(
        "budget",
        type=float
    )

    result = final_decision(
        item,
        budget
    )

    return jsonify({
        "product": item,
        "analysis": result,
        "explainable": True,
        "engine": "ShopGuard Decision Intelligence v2"
    })


@app.get("/api/recommendations")
def recommendations():

    budget = request.args.get(
        "budget",
        type=float
    )

    results = []

    for product in PRODUCTS:

        analysis = final_decision(
            product,
            budget
        )

        results.append({
            **product,
            "decisionScore": analysis["score"],
            "decision": analysis["action"],
            "riskLevel": analysis["riskLevel"]
        })

    results.sort(
        key=lambda x: x["decisionScore"],
        reverse=True
    )

    return jsonify(results)


