def analyze_product_truth(product):

    review_trust = float(product.get("reviewTrust", 0))
    seller_trust = float(product.get("sellerTrust", 0))
    rating = float(product.get("rating", 0))
    review_count = int(product.get("reviews", 0))
    return_risk = float(product.get("returnRisk", 0))
    quality = float(product.get("qualityScore", 0))

    suspicious_reviews = max(
        1,
        round((100 - review_trust) * 0.35)
    )

    if review_trust >= 90:
        review_status = "HIGH TRUST"
    elif review_trust >= 75:
        review_status = "MODERATE TRUST"
    else:
        review_status = "LOW TRUST"

    if seller_trust >= 90:
        seller_status = "HIGH"
    elif seller_trust >= 75:
        seller_status = "MODERATE"
    else:
        seller_status = "LOW"

    if seller_trust >= 90 and review_trust >= 90:
        scam_score = 10
        scam_level = "LOW"
    elif seller_trust >= 75 and review_trust >= 75:
        scam_score = 30
        scam_level = "MODERATE"
    else:
        scam_score = 60
        scam_level = "HIGH"

    claim_score = round(
        (
            quality * 0.45
            + review_trust * 0.30
            + seller_trust * 0.25
        )
    )

    if claim_score >= 90:
        claim_status = "HIGH RELIABILITY"
    elif claim_score >= 75:
        claim_status = "MODERATE RELIABILITY"
    else:
        claim_status = "LOW RELIABILITY"

    if return_risk <= 15:
        return_status = "LOW"
    elif return_risk <= 30:
        return_status = "MODERATE"
    else:
        return_status = "HIGH"

    trust_score = round(
        seller_trust * 0.30
        + review_trust * 0.30
        + claim_score * 0.20
        + (100 - scam_score) * 0.15
        + (100 - return_risk) * 0.05
    )

    if trust_score >= 85:
        overall_status = "HIGH TRUST"
        risk_level = "LOW"
    elif trust_score >= 70:
        overall_status = "MODERATE TRUST"
        risk_level = "MEDIUM"
    else:
        overall_status = "LOW TRUST"
        risk_level = "HIGH"

    reasons = []

    if review_trust >= 90:
        reasons.append(
            "Strong review authenticity indicators detected."
        )
    else:
        reasons.append(
            "Some reviews may require additional verification."
        )

    if seller_trust >= 90:
        reasons.append(
            "Seller has a strong trust profile."
        )
    else:
        reasons.append(
            "Seller trust is below the high-confidence threshold."
        )

    if scam_score <= 20:
        reasons.append(
            "No major scam indicators detected."
        )
    else:
        reasons.append(
            "Potential purchase-risk indicators require attention."
        )

    if claim_score >= 85:
        reasons.append(
            "Product claims are broadly consistent with available quality signals."
        )
    else:
        reasons.append(
            "Some product claims should be independently verified."
        )

    if return_risk <= 15:
        reasons.append(
            "Predicted return risk is low."
        )

    warnings = []

    if review_count < 100:
        warnings.append(
            "Limited review volume."
        )

    if rating >= 4.8 and review_trust < 80:
        warnings.append(
            "Very high rating with weaker review-trust signals."
        )

    if seller_trust < 70:
        warnings.append(
            "Seller trust is below the recommended level."
        )

    if claim_score < 70:
        warnings.append(
            "Product claims should be verified before purchase."
        )

    return {
        "overallStatus": overall_status,
        "riskLevel": risk_level,
        "trustScore": trust_score,

        "reviews": {
            "rating": rating,
            "reviewCount": review_count,
            "reviewTrust": review_trust,
            "estimatedSuspiciousPercent": suspicious_reviews,
            "status": review_status
        },

        "seller": {
            "sellerTrust": seller_trust,
            "status": seller_status
        },

        "claims": {
            "score": claim_score,
            "status": claim_status
        },

        "scam": {
            "score": scam_score,
            "level": scam_level
        },

        "returns": {
            "risk": return_risk,
            "status": return_status
        },

        "reasons": reasons,
        "warnings": warnings
    }


