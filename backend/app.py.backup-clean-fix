def build_decision_intelligence(product):

    price = float(product.get("price", 0))
    original = float(product.get("originalPrice", price))
    quality = float(product.get("qualityScore", 0))
    seller = float(product.get("sellerTrust", 0))
    reviews = float(product.get("reviewTrust", 0))
    compatibility = float(product.get("compatibilityScore", 0))
    eco = float(product.get("ecoScore", 0))
    return_risk = float(product.get("returnRisk", 0))
    rating = float(product.get("rating", 0))

    discount = round(
        ((original - price) / original) * 100,
        1
    ) if original else 0

    price_score = max(
        0,
        min(
            100,
            round(
                75
                + discount * 0.8
                + (quality - 80) * 0.3
            )
        )
    )

    security = round(
        seller * 0.35
        + reviews * 0.30
        + (100 - return_risk) * 0.20
        + quality * 0.15
    )

    scam_score = round(
        max(
            0,
            min(
                100,
                100 - (
                    seller * 0.45
                    + reviews * 0.35
                    + quality * 0.20
                )
            )
        )
    )

    regret_score = round(
        max(
            0,
            min(
                100,
                return_risk * 0.55
                + max(0, 85 - quality) * 0.25
                + max(0, 80 - compatibility) * 0.20
            )
        )
    )

    if regret_score <= 20:
        regret_level = "LOW"
    elif regret_score <= 40:
        regret_level = "MEDIUM"
    else:
        regret_level = "HIGH"

    if return_risk <= 15:
        return_status = "LOW"
    elif return_risk <= 30:
        return_status = "MEDIUM"
    else:
        return_status = "HIGH"

    score = round(
        price_score * 0.18
        + quality * 0.17
        + seller * 0.14
        + reviews * 0.13
        + compatibility * 0.12
        + security * 0.10
        + eco * 0.06
        + (100 - return_risk) * 0.05
        + (100 - regret_score) * 0.05
    )

    if score >= 82 and scam_score <= 25 and return_risk <= 25:
        action = "BUY"
        decision_color = "GREEN"
    elif score >= 68 and scam_score <= 45:
        action = "WAIT"
        decision_color = "YELLOW"
    else:
        action = "AVOID"
        decision_color = "RED"

    reasons = []
    warnings = []

    if seller >= 90:
        reasons.append("Seller has a strong trust profile.")

    if reviews >= 90:
        reasons.append("Review authenticity indicators are strong.")

    if quality >= 90:
        reasons.append("Product quality score is excellent.")

    if compatibility >= 90:
        reasons.append("Product compatibility is excellent.")

    if discount >= 10:
        reasons.append("Current discount provides meaningful value.")

    if return_risk <= 15:
        reasons.append("Predicted return risk is low.")

    if scam_score <= 20:
        reasons.append("No major scam indicators detected.")

    if eco >= 75:
        reasons.append("Product has a strong sustainability score.")

    if seller < 75:
        warnings.append("Seller trust requires additional verification.")

    if reviews < 75:
        warnings.append("Review trust is below the preferred threshold.")

    if return_risk > 30:
        warnings.append("Return risk is relatively high.")

    if compatibility < 70:
        warnings.append("Compatibility should be checked carefully.")

    if scam_score > 40:
        warnings.append("Potential scam indicators require attention.")

    if regret_score > 40:
        warnings.append("Higher regret probability detected.")

    if not reasons:
        reasons.append(
            "Decision is based on multiple ShopGuard AI signals."
        )

    return {
        "action": action,
        "decisionColor": decision_color,
        "score": score,

        "signals": {
            "price": price_score,
            "quality": quality,
            "seller": seller,
            "reviews": reviews,
            "compatibility": compatibility,
            "security": security,
            "eco": eco,
            "returns": round(100 - return_risk),
            "regret": round(100 - regret_score)
        },

        "price": {
            "current": price,
            "original": original,
            "discount": discount,
            "status": (
                "GOOD VALUE"
                if discount >= 10
                else "FAIR"
                if discount > 0
                else "NO DISCOUNT"
            )
        },

        "security": {
            "score": round(security),
            "scamRisk": scam_score,
            "level": (
                "LOW"
                if scam_score <= 20
                else "MEDIUM"
                if scam_score <= 40
                else "HIGH"
            )
        },

        "reviews": {
            "rating": rating,
            "trust": reviews,
            "count": int(product.get("reviews", 0))
        },

        "seller": {
            "name": product.get("seller", "Unknown Seller"),
            "trust": seller
        },

        "returns": {
            "risk": return_risk,
            "status": return_status
        },

        "regret": {
            "score": regret_score,
            "level": regret_level
        },

        "reasons": reasons,
        "warnings": warnings,

        "engine": "ShopGuard Decision Intelligence v3",
        "explainable": True
    }


