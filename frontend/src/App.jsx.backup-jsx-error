import { useEffect, useMemo, useState } from "react";
import axios from "axios";
import {
  ShieldCheck,
  Search,
  ShoppingCart,
  Star,
  Plus,
  Minus,
  Trash2,
  Brain,
  Sparkles,
  ArrowRight,
  PackageCheck,
  Leaf,
  ShieldAlert,
  X
} from "lucide-react";
import "./App.css";

const API_URL = import.meta.env.VITE_API_URL || "http://127.0.0.1:5000";

function App() {
  const [products, setProducts] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All");
  const [cart, setCart] = useState([]);
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [analysis, setAnalysis] = useState(null);
  const [analysisLoading, setAnalysisLoading] = useState(false);
  const [analysisError, setAnalysisError] = useState("");
  const [intelligence, setIntelligence] = useState(null);

  useEffect(() => {
    fetchProducts();
  }, []);

  const fetchProducts = async () => {
    try {
      setLoading(true);
      setError("");

      const response = await axios.get(`${API_URL}/api/products`);

      const data = response.data?.value || response.data || [];

      setProducts(data);
    } catch (err) {
      console.error("Product API error:", err);
      setError("Unable to load products from ShopGuard AI backend.");
    } finally {
      setLoading(false);
    }
  };

  const categories = useMemo(() => {
    const unique = [...new Set(products.map((p) => p.category))];
    return ["All", ...unique];
  }, [products]);

  const filteredProducts = useMemo(() => {
    return products.filter((product) => {
      const matchesSearch =
        product.name?.toLowerCase().includes(search.toLowerCase()) ||
        product.brand?.toLowerCase().includes(search.toLowerCase()) ||
        product.category?.toLowerCase().includes(search.toLowerCase());

      const matchesCategory =
        category === "All" || product.category === category;

      return matchesSearch && matchesCategory;
    });
  }, [products, search, category]);

  const analyzeProduct = async (product) => {
    try {
      setSelectedProduct(product);
      setAnalysis(null);
      setIntelligence(null);
      setAnalysisError("");
      setAnalysisLoading(true);

      const endpoints = [
        `api/analyze/${product.id}`,
        `api/decision/${product.id}`,
        `api/price-intelligence/${product.id}`,
        `api/product-truth/${product.id}`,
        `api/decision-intelligence/${product.id}`,
        `api/security-intelligence/${product.id}`,
        `api/negotiation/${product.id}`
      ];

      const results = await Promise.all(
        endpoints.map(async (endpoint) => {
          try {
            const response = await axios.get(`${API_URL}/${endpoint}`);
            return {
              endpoint,
              data: response.data,
              success: true
            };
          } catch (error) {
            console.warn(`ShopGuard API failed: ${endpoint}`, error);
            return {
              endpoint,
              data: null,
              success: false
            };
          }
        })
      );

      const getResult = (name) =>
        results.find((item) => item.endpoint === name)?.data || null;

      const mainAnalysis = getResult(`api/analyze/${product.id}`);

      setAnalysis(mainAnalysis);

      setIntelligence({
        decision: getResult(`api/decision/${product.id}`),
        price: getResult(`api/price-intelligence/${product.id}`),
        truth: getResult(`api/product-truth/${product.id}`),
        decisionIntelligence: getResult(
          `api/decision-intelligence/${product.id}`
        ),
        security: getResult(`api/security-intelligence/${product.id}`),
        negotiation: getResult(`api/negotiation/${product.id}`)
      });
    } catch (err) {
      console.error("ShopGuard AI analysis error:", err);
      setAnalysisError(
        err.response?.data?.error ||
        "Unable to complete ShopGuard AI analysis."
      );
    } finally {
      setAnalysisLoading(false);
    }
  };


  const addToCart = (product) => {
    setCart((current) => {
      const existing = current.find((item) => item.id === product.id);

      if (existing) {
        return current.map((item) =>
          item.id === product.id
            ? { ...item, quantity: item.quantity + 1 }
            : item
        );
      }

      return [...current, { ...product, quantity: 1 }];
    });
  };

  const increaseQuantity = (id) => {
    setCart((current) =>
      current.map((item) =>
        item.id === id
          ? { ...item, quantity: item.quantity + 1 }
          : item
      )
    );
  };

  const decreaseQuantity = (id) => {
    setCart((current) =>
      current
        .map((item) =>
          item.id === id
            ? { ...item, quantity: item.quantity - 1 }
            : item
        )
        .filter((item) => item.quantity > 0)
    );
  };

  const removeFromCart = (id) => {
    setCart((current) => current.filter((item) => item.id !== id));
  };

  const cartCount = cart.reduce((sum, item) => sum + item.quantity, 0);

  const cartTotal = cart.reduce(
    (sum, item) => sum + item.price * item.quantity,
    0
  );

  const getTrustScore = (product) => {
    const scores = [
      product.sellerTrust,
      product.reviewTrust,
      product.qualityScore,
      product.compatibilityScore,
      product.ecoScore
    ].filter((value) => typeof value === "number");

    if (!scores.length) return 0;

    return Math.round(
      scores.reduce((sum, value) => sum + value, 0) / scores.length
    );
  };

  const formatPrice = (price) =>
    new Intl.NumberFormat("en-IN", {
      style: "currency",
      currency: "INR",
      maximumFractionDigits: 0
    }).format(price);

  return (
    <div className="app">
      <nav className="navbar">
        <a href="#home" className="logo">
          <ShieldCheck size={28} />
          <span>ShopGuard<span>AI</span></span>
        </a>

        <div className="nav-links">
          <a href="#home">Home</a>
          <a href="#products">Products</a>
          <a href="#categories">Categories</a>
          <a href="#ai">AI Intelligence</a>
        </div>

        <a href="#cart" className="cart-button">
          <ShoppingCart size={21} />
          <span>{cartCount}</span>
        </a>
      </nav>

      <main>
        <section className="hero" id="home">
          <div className="hero-content">
            <div className="eyebrow">
              <Sparkles size={16} />
              AI-Powered Shopping Intelligence
            </div>

            <h1>
              Shop Smarter.
              <br />
              <span>ShopGuard AI.</span>
            </h1>

            <p>
              Every product can be evaluated by ShopGuard AI. Discover trusted
              products, detect risks and make smarter purchasing decisions.
            </p>

            <div className="hero-actions">
              <a href="#products" className="primary-button">
                Explore Products
                <ArrowRight size={18} />
              </a>

              <a href="#ai" className="secondary-button">
                <Brain size={18} />
                AI Intelligence
              </a>
            </div>
          </div>

          <div className="hero-card">
            <ShieldCheck size={70} />
            <h3>ShopGuard AI</h3>
            <p>Intelligent product evaluation and shopping risk analysis.</p>

            <div className="hero-stats">
              <div>
                <strong>99%</strong>
                <span>Protection</span>
              </div>
              <div>
                <strong>AI</strong>
                <span>Powered</span>
              </div>
              <div>
                <strong>24/7</strong>
                <span>Analysis</span>
              </div>
            </div>
          </div>
        </section>

        <section className="products-section" id="products">
          <div className="section-heading">
            <div>
              <span>SHOPGUARD MARKETPLACE</span>
              <h2>Explore Products</h2>
              <p>Real products loaded directly from the ShopGuard AI backend.</p>
            </div>

            <div className="search-box">
              <Search size={19} />
              <input
                type="text"
                placeholder="Search products..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
              />
              {search && (
                <button onClick={() => setSearch("")}>
                  <X size={17} />
                </button>
              )}
            </div>
          </div>

          <div className="category-tabs" id="categories">
            {categories.map((item) => (
              <button
                key={item}
                className={category === item ? "active" : ""}
                onClick={() => setCategory(item)}
              >
                {item}
              </button>
            ))}
          </div>

          {loading && (
            <div className="loading">
              <Brain size={30} />
              <p>Loading products from ShopGuard AI...</p>
            </div>
          )}

          {error && (
            <div className="error-box">
              <ShieldAlert size={30} />
              <div>
                <strong>Backend connection failed</strong>
                <p>{error}</p>
                <button onClick={fetchProducts}>Retry</button>
              </div>
            </div>
          )}

          {!loading && !error && (
            <div className="products-grid">
              {filteredProducts.map((product) => {
                const trustScore = getTrustScore(product);

                return (
                  <article className="product-card" key={product.id}>
                    <div className="product-image">
                      <img src={product.image} alt={product.name} />

                      <div className="trust-badge">
                        <ShieldCheck size={15} />
                        {trustScore}% Trusted
                      </div>
                    </div>

                    <div className="product-content">
                      <span className="product-category">
                        {product.category}
                      </span>

                      <h3>{product.name}</h3>

                      <p className="brand">
                        {product.brand} · {product.seller}
                      </p>

                      <div className="rating">
                        <Star size={16} fill="currentColor" />
                        {product.rating}
                        <span>({product.reviews})</span>
                      </div>

                      <div className="ai-scores">
                        <span>
                          Quality <b>{product.qualityScore}%</b>
                        </span>
                        <span>
                          Seller <b>{product.sellerTrust}%</b>
                        </span>
                        <span>
                          Eco <b>{product.ecoScore}%</b>
                        </span>
                      </div>

                      <div className="product-bottom">
                        <div>
                          <strong>{formatPrice(product.price)}</strong>
                          {product.originalPrice > product.price && (
                            <del>{formatPrice(product.originalPrice)}</del>
                          )}
                        </div>

                        <button
                          className="add-button"
                          onClick={() => addToCart(product)}
                        >
                          <Plus size={18} />
                          Add
                        </button>
                      </div>

                      <button
                        className="analyze-button"
                        onClick={() => analyzeProduct(product)}
                      >
                        <Brain size={16} />
                        Analyze with ShopGuard AI
                      </button>
                    </div>
                  </article>
                );
              })}
            </div>
          )}

          {!loading && !error && filteredProducts.length === 0 && (
            <div className="empty-results">
              <Search size={40} />
              <h3>No products found</h3>
              <p>Try another search or category.</p>
            </div>
          )}
        </section>

        <section className="ai-section" id="ai">
          <div>
            <span>SHOPGUARD INTELLIGENCE</span>
            <h2>Make Better Shopping Decisions</h2>
            <p>
              ShopGuard AI analyzes products using intelligent decision systems
              to identify product quality, seller trust, review reliability,
              pricing signals, compatibility and potential shopping risks.
            </p>
          </div>

          <div className="ai-features">
            <div>
              <ShieldCheck />
              <h3>Trust Analysis</h3>
              <p>Evaluate seller and review trust signals.</p>
            </div>

            <div>
              <Brain />
              <h3>AI Decision Engine</h3>
              <p>Analyze multiple product intelligence signals.</p>
            </div>

            <div>
              <Leaf />
              <h3>Eco Intelligence</h3>
              <p>Check sustainability-related product scores.</p>
            </div>

            <div>
              <PackageCheck />
              <h3>Return Risk</h3>
              <p>Understand potential product return risk.</p>
            </div>
          </div>
        </section>

        <section className="cart-section" id="cart">
          <div className="section-heading">
            <div>
              <span>YOUR SHOPPING CART</span>
              <h2>Cart ({cartCount})</h2>
            </div>
          </div>

          {cart.length === 0 ? (
            <div className="empty-cart">
              <ShoppingCart size={50} />
              <h3>Your cart is empty</h3>
              <p>Add products from the marketplace to get started.</p>
              <a href="#products" className="primary-button">
                Explore Products
              </a>
            </div>
          ) : (
            <div className="cart-layout">
              <div className="cart-items">
                {cart.map((item) => (
                  <div className="cart-item" key={item.id}>
                    <img src={item.image} alt={item.name} />

                    <div className="cart-item-info">
                      <h3>{item.name}</h3>
                      <p>{formatPrice(item.price)}</p>

                      <div className="quantity">
                        <button onClick={() => decreaseQuantity(item.id)}>
                          <Minus size={16} />
                        </button>

                        <span>{item.quantity}</span>

                        <button onClick={() => increaseQuantity(item.id)}>
                          <Plus size={16} />
                        </button>
                      </div>
                    </div>

                    <div className="cart-item-total">
                      <strong>
                        {formatPrice(item.price * item.quantity)}
                      </strong>

                      <button onClick={() => removeFromCart(item.id)}>
                        <Trash2 size={18} />
                      </button>
                    </div>
                  </div>
                ))}
              </div>

              <div className="order-summary">
                <h3>Order Summary</h3>

                <div>
                  <span>Items</span>
                  <strong>{cartCount}</strong>
                </div>

                <div>
                  <span>Subtotal</span>
                  <strong>{formatPrice(cartTotal)}</strong>
                </div>

                <div>
                  <span>Delivery</span>
                  <strong>FREE</strong>
                </div>

                <hr />

                <div className="total">
                  <span>Total</span>
                  <strong>{formatPrice(cartTotal)}</strong>
                </div>

                <button className="checkout-button">
                  Proceed to Checkout
                </button>
              </div>
            </div>
          )}
        </section>
      </main>

      {selectedProduct && (
        <div
          className="modal-overlay"
          onClick={() => {
            setSelectedProduct(null);
            setAnalysis(null);
          }}
        >
          <div
            className="analysis-modal"
            onClick={(e) => e.stopPropagation()}
          >
            <button
              className="modal-close"
              onClick={() => {
                setSelectedProduct(null);
                setAnalysis(null);
              }}
            >
              <X size={22} />
            </button>

            <div className="modal-icon">
              <Brain size={34} />
            </div>

            <span>SHOPGUARD AI ANALYSIS</span>

            <h2>{selectedProduct.name}</h2>

            <p>
              {selectedProduct.brand} ? {selectedProduct.seller}
            </p>

            {analysisLoading && (
              <div className="analysis-loading">
                <Brain size={32} />
                <h3>Analyzing product...</h3>
                <p>
                  ShopGuard AI is evaluating price, reviews, seller trust,
                  quality and shopping risks.
                </p>
              </div>
            )}

            {analysisError && (
              <div className="analysis-error">
                <ShieldAlert size={28} />
                <h3>Analysis failed</h3>
                <p>{analysisError}</p>

                <button
                  onClick={() => analyzeProduct(selectedProduct)}
                  className="primary-button"
                >
                  Try Again
                </button>
              </div>
            )}

            {analysis && (
              <>
                <div className="analysis-grid">
                  <div>
                    <strong>
                      {analysis.quality?.score ??
                        analysis.qualityScore ??
                        selectedProduct.qualityScore}%
                    </strong>
                    <span>Quality</span>
                  </div>

                  <div>
                    <strong>
                      {analysis.seller?.score ??
                        analysis.sellerTrust ??
                        selectedProduct.sellerTrust}%
                    </strong>
                    <span>Seller Trust</span>
                  </div>

                  <div>
                    <strong>
                      {analysis.reviews?.score ??
                        analysis.reviewTrust ??
                        selectedProduct.reviewTrust}%
                    </strong>
                    <span>Review Trust</span>
                  </div>

                  <div>
                    <strong>
                      {analysis.compatibility?.score ??
                        selectedProduct.compatibilityScore}%
                    </strong>
                    <span>Compatibility</span>
                  </div>

                  <div>
                    <strong>
                      {analysis.eco?.score ??
                        selectedProduct.ecoScore}%
                    </strong>
                    <span>Eco Score</span>
                  </div>

                  <div>
                    <strong>
                      {analysis.returns?.risk ??
                        selectedProduct.returnRisk}%
                    </strong>
                    <span>Return Risk</span>
                  </div>
                </div>

                <div className="analysis-result">
                  <ShieldCheck size={22} />

                  <div>
                    <strong>ShopGuard AI Decision</strong>

                    <p>
                      {analysis.decision ||
                        analysis.recommendation ||
                        analysis.verdict ||
                        "Product analysis completed successfully."}
                    </p>
                  </div>
                </div>

                {analysis.scam && (
                  <div className="analysis-result">
                    <ShieldAlert size={22} />

                    <div>
                      <strong>Scam Risk</strong>

                      <p>
                        Risk: {analysis.scam.risk ?? "N/A"}%
                        {" ? "}
                        Level: {analysis.scam.level ?? "N/A"}
                      </p>
                    </div>
                  </div>
                )}

                {analysis.price && (
                  <div className="analysis-result">
                    <PackageCheck size={22} />

                    <div>
                      <strong>Price Intelligence</strong>

                      <p>
                        Score: {analysis.price.score ?? "N/A"}
                        {" ? "}
                        Discount: {analysis.price.discount ?? 0}%
                      </p>
                    </div>
                  </div>
                )}
              </>

              {intelligence && (
                <div className="full-intelligence">
                  <div className="intelligence-title">
                    <Sparkles size={20} />
                    <h3>ShopGuard AI Intelligence</h3>
                  </div>

                  {intelligence.decision && (
                    <div className="intelligence-card">
                      <Brain size={22} />
                      <div>
                        <strong>Decision Intelligence</strong>
                        <p>
                          {typeof intelligence.decision === "string"
                            ? intelligence.decision
                            : intelligence.decision.decision ||
                              intelligence.decision.recommendation ||
                              intelligence.decision.verdict ||
                              "Decision analysis completed."}
                        </p>
                      </div>
                    </div>
                  )}

                  {intelligence.price && (
                    <div className="intelligence-card">
                      <PackageCheck size={22} />
                      <div>
                        <strong>Price Intelligence</strong>
                        <p>
                          Score:{" "}
                          {intelligence.price.score ??
                            intelligence.price.priceScore ??
                            "N/A"}
                          {" ? "}
                          Discount:{" "}
                          {intelligence.price.discount ??
                            intelligence.price.discountPercent ??
                            0}
                          %
                        </p>
                      </div>
                    </div>
                  )}

                  {intelligence.truth && (
                    <div className="intelligence-card">
                      <ShieldCheck size={22} />
                      <div>
                        <strong>Product Truth</strong>
                        <p>
                          {intelligence.truth.verdict ||
                            intelligence.truth.status ||
                            intelligence.truth.message ||
                            "Product truth analysis completed."}
                        </p>
                      </div>
                    </div>
                  )}

                  {intelligence.decisionIntelligence && (
                    <div className="intelligence-card">
                      <Brain size={22} />
                      <div>
                        <strong>Decision Engine</strong>
                        <p>
                          {intelligence.decisionIntelligence.verdict ||
                            intelligence.decisionIntelligence.recommendation ||
                            intelligence.decisionIntelligence.message ||
                            "Decision intelligence completed."}
                        </p>
                      </div>
                    </div>
                  )}

                  {intelligence.security && (
                    <div className="intelligence-card">
                      <ShieldAlert size={22} />
                      <div>
                        <strong>Security Intelligence</strong>
                        <p>
                          {intelligence.security.level ||
                            intelligence.security.riskLevel ||
                            intelligence.security.verdict ||
                            "Security analysis completed."}
                        </p>
                      </div>
                    </div>
                  )}

                  {intelligence.negotiation && (
                    <div className="intelligence-card">
                      <PackageCheck size={22} />
                      <div>
                        <strong>Negotiation Intelligence</strong>
                        <p>
                          {intelligence.negotiation.offer ||
                            intelligence.negotiation.suggestedPrice ||
                            intelligence.negotiation.recommendation ||
                            "Negotiation analysis completed."}
                        </p>
                      </div>
                    </div>
                  )}
                </div>
              )}
            )}
          </div>
        </div>
      )}

      <footer>
        <div className="logo">
          <ShieldCheck size={24} />
          <span>ShopGuard<span>AI</span></span>
        </div>
        <p>AI-powered intelligent shopping protection.</p>
        <small>© 2026 ShopGuard AI</small>
      </footer>
    </div>
  );
}

export default App;
